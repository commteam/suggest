# Supabase 프로젝트 설정 > API 에서 확인하세요.
# 두 값을 모두 채우면 Supabase 모드, 비워두면 데모 모드(localStorage)로 동작합니다.
# 실제 값은 .env.local 에 넣고 커밋하지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (선택) 관리자 계정 이메일. 설정하면 관리자 로그인 화면에서 이메일 칸 없이 비밀번호만 입력합니다.
# 비밀번호는 여기에 넣지 마세요. Supabase > Authentication > Users 에서 이 계정의 비밀번호로 정합니다.
VITE_ADMIN_EMAIL=
